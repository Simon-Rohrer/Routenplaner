{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Lokalen Server starten",
      "type": "shell",
      "command": "python3",
      "args": [
        "server.py"
      ],
      "isBackground": true,
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": {
        "owner": "local-server",
        "pattern": {
          "regexp": "."
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^Serving PaketPilot on .*$",
          "endsPattern": "^Serving PaketPilot on .*$"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
